# Copy to .env and fill in real values. .env is git-ignored; this file is not.

# Super Market API key, scopes: read + trade only. Settings -> API Keys.
SIG_API_KEY=

# Telegram bot token, from @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram chat id to send alerts to and accept /kill from. The bot must
# ignore commands from any other chat id (docs/LAUNCH_CHECKLIST.md).
TELEGRAM_CHAT_ID=
